{
  "openapi": "3.1.0",
  "info": {
    "title": "Glycan Mass Spec Annotator API",
    "description": "Legacy threshold-audit API. Not a glycan tandem-MS structure annotator. Generated OpenAPI schema is available at /openapi.json when the FastAPI service runs.",
    "version": "3.0.0-ENTERPRISE",
    "contact": {
      "name": "Dr. Abu Suraih Sakhri",
      "url": "https://github.com/abusuraihsakhri"
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health and metadata check",
        "responses": {
          "200": {
            "description": "System optimal"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "Return process-local JSON counters",
        "responses": {
          "200": {
            "description": "JSON object with processing and audit counts"
          }
        }
      }
    },
    "/api/audit": {
      "post": {
        "summary": "Evaluate legacy threshold-audit payload",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "task_id": {
                    "type": "string"
                  },
                  "target_identifier": {
                    "type": "string"
                  },
                  "primary_metric": {
                    "type": "number"
                  },
                  "secondary_metric": {
                    "type": "number"
                  },
                  "status_descriptor": {
                    "type": "string"
                  },
                  "is_critical_flag": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "task_id",
                  "target_identifier",
                  "primary_metric"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Threshold-audit dossier with signed in-memory audit hash"
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "summary": "Return deterministic mock response to a supervisor inquiry",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "query": {
                    "type": "string"
                  }
                },
                "required": [
                  "query"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Supervisory response"
          }
        }
      }
    },
    "/api/audit/logs": {
      "get": {
        "summary": "Read audit ledger with administrative token",
        "responses": {
          "200": {
            "description": "Cryptographic audit trail"
          },
          "403": {
            "description": "Audit access disabled or unauthorized"
          }
        },
        "parameters": [
          {
            "name": "X-Audit-Token",
            "in": "header",
            "required": false,
            "description": "Required if AUDIT_ADMIN_TOKEN is configured; otherwise log access is disabled",
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    }
  }
}
